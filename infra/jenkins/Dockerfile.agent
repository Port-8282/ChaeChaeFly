# syntax=docker/dockerfile:1
# Official static Docker CLI and plugins also run on the Debian Agent base.
FROM docker:29.9.1-cli@sha256:6fae2214c3121a28d5aa639d09032f61310b7c9c75ffbad1025f261a1b621800 AS docker-cli
FROM jenkins/inbound-agent:3395.v6e5377b_0fb_3c-3-jdk21@sha256:5069347cd3e72e5924e54c04fceb67209b41c8d0a3ab1c2b3f740e5fb2fab92a

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
# Verify CLI compatibility during image build without accessing any Docker daemon.
RUN docker --version && docker buildx version && docker compose version && python3 --version
USER jenkins
WORKDIR /home/jenkins/agent
