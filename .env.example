# Configuration names are a draft, not a runnable Compose environment.
# Agree on actual ports/products and service-level variable ownership in stage 3.
# Never put real passwords or API keys in this file.
COMPOSE_PROJECT_NAME=port8282
APP_ENV=local
TZ=Asia/Seoul

# Back -> AI, AI -> ML. Use Compose service DNS, not localhost.
AI_BASE_URL=
ML_BASE_URL=

# Pass the DB connection only to Back and the migration job.
DATABASE_URL=

# Pass LLM credentials only to the AI service.
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
