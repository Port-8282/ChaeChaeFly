# 로컬 개발 전용 예시. 저장소 루트에서 .env로 복사한다.
# 아래 비밀번호는 공개된 개발 예시이며 운영·공유 서버에서 사용하지 않는다.
COMPOSE_PROJECT_NAME=port8282
APP_PORT=8282
TZ=Asia/Seoul

POSTGRES_DB=port8282
POSTGRES_PASSWORD=port8282_local_admin_change_me
DB_APP_USER=port8282_app
DB_APP_PASSWORD=port8282_local_app_change_me

# LLM 기능 도입 전에는 비워 두어도 된다. 실제 키는 Git에 올리지 않는다.
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 내부 주소는 Compose에 정의한다: back:8080 / ai:8000 / ml:8000 / db:5432
# Spring 로컬 단독 실행의 포트 변경은 터미널에서 SERVER_PORT로 지정한다.
# Spring·Vite가 이 루트 .env를 직접 읽는 것은 아니다. Compose가 필요한 값만 전달한다.
